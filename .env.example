# Finance Agent AWS SaaS - Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================
# STAGE 1: Initial Setup
# ============================================================
# Your AWS Account ID (get with: aws sts get-caller-identity --query Account --output text)
AWS_ACCOUNT_ID=123456789012

# Your default AWS region for most infrastructure (e.g., us-east-1, us-west-2, eu-west-1)
DEFAULT_AWS_REGION=us-east-1

# ============================================================
# STAGE 2: SageMaker Endpoint
# ============================================================
# After deploying stage 2, add the endpoint name
SAGEMAKER_ENDPOINT=finance-agent-aws-saas-embedding-endpoint

# ============================================================
# STAGE 3: Ingestion Pipeline
# ============================================================
# After deploying stage 3, add these values
VECTOR_BUCKET=finance-agent-aws-saas-vectors-123456789012
FINANCE_AGENT_AWS_SAAS_API_ENDPOINT=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod/ingest
FINANCE_AGENT_AWS_SAAS_API_KEY=your-api-key-here

# ============================================================
# STAGE 4: Researcher Agent
# ============================================================
# Your OpenAI API key for the researcher agent
OPENAI_API_KEY=sk-...

# ============================================================
# STAGE 5: Database
# ============================================================
# After deploying stage 5, add these values
AURORA_CLUSTER_ARN=arn:aws:rds:us-east-1:123456789012:cluster:finance-agent-aws-saas-aurora-cluster
AURORA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:finance-agent-aws-saas-aurora-credentials-xxxxx

# ============================================================
# STAGE 6: Agents
# ============================================================
# Bedrock model configuration
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# Bedrock region (us-west-2 has the most models available)
BEDROCK_REGION=us-west-2

# Polygon.io API for real-time stock prices (sign up free at polygon.io) - change free to paid if you're using paid plan
POLYGON_API_KEY=your_polygon_api_key_here
POLYGON_PLAN=free

# ============================================================
# STAGE 7: Frontend & API
# ============================================================
# The API uses database configuration from stage 5 above (AURORA_CLUSTER_ARN, AURORA_SECRET_ARN)
# Optional: specify database name (defaults to "finance_agent_aws_saas" if not set)
AURORA_DATABASE=finance_agent_aws_saas

# Clerk configuration for JWT validation
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-instance.clerk.accounts.dev

# SQS configuration (will be set by Terraform in deployment)
SQS_QUEUE_URL=

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
CLOUDFRONT_URL=

# ============================================================
# STAGE 8: Observability (to be added)
# ============================================================
# LANGFUSE_PUBLIC_KEY=...
# LANGFUSE_SECRET_KEY=...
# LANGFUSE_HOST=https://cloud.langfuse.com